<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Izinkan validasi SSL otomatis cPanel / Let's Encrypt (.well-known)
    RewriteRule ^\.well-known/ - [L]

    # 2. Blokir akses publik langsung ke file sensitif & konfigurasi Laravel
    RewriteRule ^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.ts|tsconfig\.json|README\.md|PRD\.md|ARCHITECTURE\.md|DESIGN\.md|AGENTS\.md)$ - [F,L,NC]

    # 3. Blokir akses langsung ke folder internal Laravel (kecuali /storage/ untuk gambar publik yang diteruskan ke public/storage)
    RewriteRule ^(app|bootstrap|config|database|node_modules|resources|routes|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^storage/(app|framework|logs)(/|$) - [F,L,NC]

    # 4. Paksa HTTPS secara otomatis di domain publik (kecuali localhost/127.0.0.1)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 5. Arahkan seluruh request langsung ke folder /public secara transparan tanpa /public di URL
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Nonaktifkan directory listing agar tidak pernah muncul halaman "Index of /"
Options -Indexes

# Lindungi seluruh file dot (seperti .env, .htaccess, .gitignore)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
